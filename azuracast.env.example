# Local runtime configuration for AzuraCast
# This file is not meant to be committed with real secrets.
# In Coolify, prefer injecting these values as environment variables.

TZ=Europe/Paris
AZURACAST_PUID=1000
AZURACAST_PGID=1000
INIT_BASE_URL=https://radio.rustyjamesblog.link
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443
AZURACAST_SFTP_PORT=2022
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword!
MYSQL_DATABASE=azuracast
MYSQL_USER=azuracast
MYSQL_PASSWORD=ChangeThisDbPassword!
ENABLE_WEB_UPDATER=false
