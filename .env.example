# Production environment variables template
# Copy this file to `.env` or inject them directly in Coolify.
# Note: port 80 and 443 are already occupied on this server, so this config exposes
# AzuraCast on 8080/8443 instead.

TZ=Europe/Paris
AZURACAST_PUID=1000
AZURACAST_PGID=1000
INIT_BASE_URL=http://45.141.21.28:8080
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443
AZURACAST_SFTP_PORT=2022
MYSQL_ROOT_PASSWORD=ChangeThisRootPassword!
MYSQL_DATABASE=azuracast
MYSQL_USER=azuracast
MYSQL_PASSWORD=ChangeThisDbPassword!
ENABLE_WEB_UPDATER=false
